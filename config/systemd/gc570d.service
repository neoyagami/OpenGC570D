# Load the portably installed GC570D module automatically during system boot.

[Unit]
Description=AVerMedia Live Gamer DUO GC570D driver
After=local-fs.target systemd-modules-load.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/gc570d/gc570d.conf
EnvironmentFile=-/etc/default/gc570d
ExecStart=/usr/local/sbin/gc570d-load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
